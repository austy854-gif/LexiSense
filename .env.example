# LexiSense - root environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# Used by docker-compose.yml / docker-compose.prod.yml (variable substitution).

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=lexisense

# --- Auth (REQUIRED - the backend fails fast if JWT_SECRET is missing) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Token iss/aud claims (must match between issuer and verifier).
JWT_ISSUER=lexisense-api
JWT_AUDIENCE=lexisense-client

# --- CORS (REQUIRED - comma-separated, no wildcard) ---
CORS_ORIGINS=http://localhost:3000

# --- AI (Emergent LLM) ---
EMERGENT_LLM_KEY=your-emergent-llm-key

# --- Email (Resend) ---
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=LexiSense <onboarding@resend.dev>
# Delivery-status webhook signing secret (whsec_...).
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret
# Intake (inbound email) webhook signing secret (whsec_...), POST /api/v1/agentic/intake/webhook.
# Separate Resend webhook => separate secret. Falls back to RESEND_WEBHOOK_SECRET (deprecated).
RESEND_INTAKE_WEBHOOK_SECRET=

# --- Public app URL (used in email links) ---
APP_URL=http://localhost:3000

# --- Object storage (S3). Leave blank to run in mock mode (dev only). ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# (S3_BUCKET_NAME is accepted as a legacy alias; AWS_S3_BUCKET wins.)
AWS_REGION=us-east-1

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Team plan Stripe prices used at checkout (client sends planId + interval,
# never a price ID). Monthly is required in production; annual is optional.
STRIPE_TEAM_PRICE_ID=
STRIPE_TEAM_PRICE_ID_ANNUAL=
# Optional legacy Stripe prices (comma-separated) that still grant the Team plan
# to existing subscribers; they can't be bought. A subscription on any price not
# listed in these three variables gets NO paid access.
STRIPE_TEAM_PRICE_IDS=
# Plan limits (single plan config: backend/utils/plans.py). Defaults shown.
# A member cap of 0 means unlimited.
BILLING_TRIAL_DAYS=7
BILLING_TRIAL_UPLOAD_LIMIT=3
BILLING_TEAM_MAX_MEMBERS=10
BILLING_TRIAL_MAX_MEMBERS=3
BILLING_TEAM_PRICE_MONTHLY=49
# Optional annual display price and the display currency. Display prices are
# checked against the Stripe prices above; on a mismatch Stripe's amount is shown
# and an error is logged.
BILLING_TEAM_PRICE_ANNUAL=
BILLING_CURRENCY=usd
# Show the Billing page, nav entry, Upgrade buttons and prices (default off).
# Read at runtime via GET /api/v1/billing/config; no frontend rebuild needed.
BILLING_UI_ENABLED=false
# Days a past-due subscriber keeps uploads/AI after a failed payment (0 = block now).
BILLING_PAST_DUE_GRACE_DAYS=7
# Contract chat rate limits (per minute). Redis-backed when REDIS_URL /
# RATE_LIMIT_REDIS_URL is set; in-process fallback if Redis is unreachable.
CHAT_RATE_LIMIT_PER_USER_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_ORG_PER_MINUTE=60

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
# Set to `production` in prod: the weak-JWT_SECRET guard only fires there.
ENVIRONMENT=development
RELEASE_VERSION=2.0.0

# --- Runtime tuning ---
# Motor connection-pool ceiling.
MONGO_MAX_POOL_SIZE=50
# Timeout (seconds) for the health-check DB/S3 probes.
HEALTH_PROBE_TIMEOUT_SECONDS=3

# --- Celery (only needed if the agentic subsystem is re-enabled) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
