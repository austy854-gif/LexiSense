# LexiSense - root environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# Used by docker-compose.yml / docker-compose.prod.yml (variable substitution).

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=lexisense

# --- Auth (REQUIRED - the backend fails fast if JWT_SECRET is missing) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Token iss/aud claims (must match between issuer and verifier).
JWT_ISSUER=lexisense-api
JWT_AUDIENCE=lexisense-client

# --- CORS (REQUIRED - comma-separated, no wildcard) ---
CORS_ORIGINS=http://localhost:3000

# --- AI (Emergent LLM) ---
EMERGENT_LLM_KEY=your-emergent-llm-key

# How many leading windows of a long contract are sent to the model (plus the
# closing section). The analysis is marked partial when the file is longer.
AI_ANALYSIS_MAX_CHUNKS=8

# --- Email (Resend) ---
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=LexiSense <onboarding@resend.dev>
# Delivery-status webhook signing secret (whsec_...).
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret
# Intake (inbound email) webhook signing secret (whsec_...), POST /api/v1/agentic/intake/webhook.
# Separate Resend webhook => separate secret. Falls back to RESEND_WEBHOOK_SECRET (deprecated).
RESEND_INTAKE_WEBHOOK_SECRET=

# --- Public app URL (used in email links) ---
APP_URL=http://localhost:3000

# --- Object storage (S3). Leave blank to run in mock mode (dev only). ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# (S3_BUCKET_NAME is accepted as a legacy alias; AWS_S3_BUCKET wins.)
AWS_REGION=us-east-1

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout accepts ONLY these six Stripe prices (server-side allowlist).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
# Optional seat caps (defaults 3/5/15/30) and display-price fallbacks used only
# when Stripe is unreachable (BILLING_<PLAN>_PRICE_MONTHLY / _ANNUAL).
# BILLING_TRIAL_MAX_MEMBERS=
# BILLING_STARTER_MAX_MEMBERS=
# BILLING_TEAM_MAX_MEMBERS=
# BILLING_BUSINESS_MAX_MEMBERS=
# Days a past-due Team subscription can still upload before the workspace is read-only.
BILLING_GRACE_DAYS=7
# Billing page/nav + "Upgrade" copy, served to the frontend via GET /billing/config.
# Off (default): billing UI hidden and blocked-access messages point to support.
BILLING_UI_ENABLED=false
# Stripe price tax_behavior shown next to prices ("inclusive" per STRIPE_SETUP.md).
# Stripe's value wins when it can be read; a mismatch is logged as an error.
BILLING_TAX_BEHAVIOR=inclusive
# Retired prices that still entitle existing subscribers (comma-separated; never purchasable).
STRIPE_LEGACY_PRICE_IDS=
# Contract chat rate limits (requests per minute).
CHAT_RATE_LIMIT_PER_USER_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_ORG_PER_MINUTE=60

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
# Set to `production` in prod: the weak-JWT_SECRET guard only fires there.
ENVIRONMENT=development
RELEASE_VERSION=2.0.0

# --- Runtime tuning ---
# Motor connection-pool ceiling.
MONGO_MAX_POOL_SIZE=50
# Timeout (seconds) for the health-check DB/S3 probes.
HEALTH_PROBE_TIMEOUT_SECONDS=3

# --- Redis (optional; see ENV_SETUP_GUIDE.md section 9) ---
# Unset: the app runs normally, rate limits are per process, and startup logs
# one warning. Set: rate limits are shared across workers through Redis.
# REDIS_URL=redis://localhost:6379/0
# Optional separate Redis for rate limits only (overrides REDIS_URL for them).
# RATE_LIMIT_REDIS_URL=

# --- Uploads ---
# Per-file upload limit in MB (default 10, clamped to 1-100). Larger -> 413.
# MAX_UPLOAD_MB=10

# --- Celery (only needed if the agentic subsystem is re-enabled) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
