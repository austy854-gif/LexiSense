# LexiSense frontend environment template
# Copy to frontend/.env and fill in real values. NEVER commit the real .env.
# NOTE: Create React App only exposes variables prefixed with REACT_APP_.

# Base URL of the backend API (no trailing slash, no /api/v1 suffix).
# The app appends /api/v1 itself.
REACT_APP_BACKEND_URL=http://localhost:8000

# Optional: Sentry DSN for frontend error tracking
REACT_APP_SENTRY_DSN=
