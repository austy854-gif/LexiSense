# LexiSense backend environment template
# Copy to backend/.env and fill in real values. NEVER commit the real .env.

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=lexisense

# --- Auth (REQUIRED - server refuses to start without JWT_SECRET) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (REQUIRED - comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:3000

# --- AI (Emergent LLM) ---
EMERGENT_LLM_KEY=your-emergent-llm-key

# --- Email (Resend) ---
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=LexiSense <onboarding@resend.dev>
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret

# --- Public app URL (used to build links inside emails) ---
APP_URL=http://localhost:3000

# --- Object storage (S3). Leave blank to run in mock mode (dev only). ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE_ID=

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
ENVIRONMENT=development
RELEASE_VERSION=2.0.0

# --- Celery (only needed if the agentic subsystem is re-enabled) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
