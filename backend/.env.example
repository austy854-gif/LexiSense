# LexiSense backend environment template
# Copy to backend/.env and fill in real values. NEVER commit the real .env.

# --- Database ---
# DATABASE_URL is preferred; MONGO_URL is the legacy fallback.
DATABASE_URL=mongodb://localhost:27017/lexisense
DB_NAME=lexisense

# --- Auth (REQUIRED - server refuses to start without JWT_SECRET) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Token iss/aud claims (must match between issuer and verifier).
JWT_ISSUER=lexisense-api
JWT_AUDIENCE=lexisense-client

# --- CORS (REQUIRED - comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:3000

# --- AI (Emergent LLM) ---
EMERGENT_LLM_KEY=your-emergent-llm-key

# --- Email (Resend) ---
RESEND_API_KEY=your-resend-api-key
SENDER_EMAIL=LexiSense <onboarding@resend.dev>
# Delivery-status webhook signing secret (whsec_...).
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret
# Intake (inbound email) webhook signing secret (whsec_...), POST /api/v1/agentic/intake/webhook.
# Separate Resend webhook => separate secret. Falls back to RESEND_WEBHOOK_SECRET (deprecated).
RESEND_INTAKE_WEBHOOK_SECRET=

# --- Public app URL (used to build links inside emails) ---
APP_URL=http://localhost:3000
# --- Approval emails (one-click Approve/Reject links) ---
# Off by default. RESEND_WEBHOOK_SECRET (above, the whsec_... Svix secret) is
# required for POST /api/v1/webhooks/resend delivery-status events.
APPROVAL_EMAILS_ENABLED=false
APPROVAL_TOKEN_TTL_HOURS=72
# Optional; default is HMAC(JWT_SECRET, "approval-token-v1"). To rotate, move the
# old value to APPROVAL_TOKEN_SECRET_PREVIOUS so outstanding links keep working.
# NOTE: rotating JWT_SECRET invalidates outstanding approval links unless
# APPROVAL_TOKEN_SECRET is set (the default key is derived from JWT_SECRET).
APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_SECRET_PREVIOUS=
# Proxy hops in front of the app that append to X-Forwarded-For (rate-limit
# client identity uses the entry this many hops from the right; 0 = ignore XFF).
# 1 = Railway edge only (current setup: Cloudflare is DNS-only). With a CDN or
# proxied Cloudflare PLUS a load balancer in front, this must be 2.
TRUSTED_PROXY_COUNT=1
# Hop (from the right) whose X-Forwarded-Proto is trusted for request.url.scheme
# (redirect Locations). Unset/invalid = TRUSTED_PROXY_COUNT; 0 = ignore XFP.
# Many LBs/CDNs OVERWRITE X-Forwarded-Proto rather than append, so with a
# CDN + LB (TRUSTED_PROXY_COUNT=2) set FORWARDED_PROTO_HOP=1.
FORWARDED_PROTO_HOP=
# uvicorn --forwarded-allow-ips (Dockerfile). Keep 127.0.0.1; never "*".
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Object storage (S3). Leave blank to run in mock mode (dev only). ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# (S3_BUCKET_NAME is accepted as a legacy alias; AWS_S3_BUCKET wins.)
AWS_REGION=us-east-1

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE_ID=
# Optional extra Stripe prices that also map to the Team plan (comma-separated,
# e.g. annual / CAD). Checkout rejects any price not listed here or above.
STRIPE_TEAM_PRICE_IDS=
# Plan limits (single plan config: backend/utils/plans.py). Defaults shown.
# A member cap of 0 means unlimited.
BILLING_TRIAL_DAYS=7
BILLING_TRIAL_UPLOAD_LIMIT=3
BILLING_TEAM_MAX_MEMBERS=10
BILLING_TRIAL_MAX_MEMBERS=3
BILLING_TEAM_PRICE_MONTHLY=49
# Days a past-due subscriber keeps uploads/AI after a failed payment (0 = block now).
BILLING_PAST_DUE_GRACE_DAYS=7

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
# Set to `production` in prod: the weak-JWT_SECRET guard only fires there.
ENVIRONMENT=development
RELEASE_VERSION=2.0.0

# --- Runtime tuning ---
# Motor connection-pool ceiling.
MONGO_MAX_POOL_SIZE=50
# Timeout (seconds) for the health-check DB/S3 probes.
HEALTH_PROBE_TIMEOUT_SECONDS=3

# --- Celery (only needed if the agentic subsystem is re-enabled) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
